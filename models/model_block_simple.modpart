//********************************************************
// HOUSEHOLD DECISIONS
//********************************************************
@#if SIMPLIFY_LEVEL < 7
// Marginal utility with the consumption-tax wedge
1/C = lambda*(1+tauc);
@#else
// Canonical marginal utility
lambda = 1/C;
@#endif

// Euler equation. At level 6 and above g=1.
lambda = betta*(lambda(+1)/g*R/PI(+1));

@#if (SIMPLIFY_LEVEL < 2) && (NO_HUMAN_CAPITAL == 0)
// Labor and education draw on the common time endowment.
omega*(L+E)^varphi = lambda*w*H(-1)*(1-tauw);
@#elseif SIMPLIFY_LEVEL < 7
// Human capital is inactive, so effective labor equals hours worked.
omega*L^varphi = lambda*w*(1-tauw);
@#else
// Canonical labor-supply condition
omega*L^varphi = lambda*w;
@#endif

@#if SIMPLIFY_LEVEL < 4
// Private-capital accumulation and optimal investment
Kp*g = (1-delta)*Kp(-1)+Ip;
1 = betta*(lambda(+1)/lambda/g*(1-delta+rk(+1)));
@#else
// Private capital is absent from the active equilibrium.
Kp = STEADY_STATE(Kp);
Ip = STEADY_STATE(Ip);
@#endif

@#if (SIMPLIFY_LEVEL < 2) && (NO_HUMAN_CAPITAL == 0)
// Human-capital accumulation and optimal education time
H = (1-deltaH)*H(-1)+chiH*E^gamma*(Kge(-1))^mu;
omega*(L+E)^varphi = lambda_H*chiH*gamma*E^(gamma-1)*(Kge(-1))^mu;
lambda_H = betta*(lambda(+1)*(1-tauw(+1))*w(+1)*L(+1)+lambda_H(+1)*(1-deltaH));
N = L*H(-1);
@#else
// Human-capital objects are inactive reporting placeholders.
H = 1;
E = 0;
lambda_H = 0;
N = L;
@#endif

//********************************************************
// FIRMS AND PRICE SETTING
//********************************************************
x1 = lambda*mc*yd+betta*thetap*(PI^chi/PI(+1))^(-epsilon)*x1(+1);
x2 = lambda*PIstar*yd+betta*thetap*(PI^chi/PI(+1))^(1-epsilon)*PIstar/PIstar(+1)*x2(+1);
epsilon*x1 = (epsilon-1)*x2;

@#if SIMPLIFY_LEVEL < 4
// Cobb-Douglas private production with public capital as an external input
Kp(-1)/N = alpha/(1-alpha)*w/rk;
(1-alpha)*mc*y/N = markupss*w;
y = A(-1)^(vartheta-1)*Kg(-1)^alphaG*Kp(-1)^alpha*N^(1-alpha);
@#elseif SIMPLIFY_LEVEL < 7
// Labor-only constant-returns production. Steady-state scales are retained so
// levels 4--6 isolate dynamics without changing the background allocation.
rk = STEADY_STATE(rk);
mc/STEADY_STATE(mc) = w/STEADY_STATE(w);
y/STEADY_STATE(y) = N/STEADY_STATE(N);
@#else
// Canonical labor-only technology and marginal cost
rk = STEADY_STATE(rk);
mc = w;
y = N;
@#endif

// Calvo price aggregation. The template sets chi=0 from level 5 onward.
1 = thetap*(PI(-1)^chi/PI)^(1-epsilon)+(1-thetap)*PIstar^(1-epsilon);

//********************************************************
// TECHNOLOGY CREATION AND ADOPTION
//********************************************************
@#if SIMPLIFY_LEVEL < 1
SDF = betta*lambda*(1+tauc)/(lambda(-1)*(1+tauc(-1)));

ln(Z/STEADY_STATE(Z)) = rho_A*ln(Z(-1)/STEADY_STATE(Z))
    +(1-rho_A)*alphaRD*ln((1-eGRD(-1))*Grd(-1)/((1-eGRD_ss)*STEADY_STATE(Grd)))
    +(1-rho_A)*alphaHA*ln(H(-1)/STEADY_STATE(H));
J = -S+phi*(SDF(+1)*A(-1)/A/(1+gammaa)*(q*V(+1)+(1-q)*J(+1)));
q = (kappaprob+epsi_q)*S^varsigma;
(1+gammaa)*A = q*phi*(Z(-1)-A(-1))+phi*A(-1);
V = (markupss-1)/markupss*mc*y+phi*SDF(+1)*V(+1)*A(-1)/A/(1+gammaa);
varsigma*q*phi*SDF(+1)/(1+gammaa)*A(-1)/A*(V(+1)-J(+1)) = S;
@#else
// Endogenous technology is absent from the active equilibrium.
SDF = STEADY_STATE(SDF);
Z = STEADY_STATE(Z);
J = STEADY_STATE(J);
q = STEADY_STATE(q);
A = STEADY_STATE(A);
V = STEADY_STATE(V);
S = STEADY_STATE(S);
@#endif

//********************************************************
// MONETARY POLICY
//********************************************************
R/Rss = (R(-1)/Rss)^rho_R*((PI/Piss)^gamma_pi*(mc/STEADY_STATE(mc))^gamma_y)^(1-rho_R)*exp(epsi_MP);

//********************************************************
// GOVERNMENT
//********************************************************
@#if SIMPLIFY_LEVEL < 3
Kg*g = (1-delta)*Kg(-1)+(1-eGI)*Igi;
@#else
Kg = STEADY_STATE(Kg);
@#endif

@#if SIMPLIFY_LEVEL < 7
// Extended fiscal block with debt and distortionary tax wedges
b = (R(-1)/PI)*b(-1)/g+Gc+Igi+Ige+Grd+T-tauw*w*N-tauc*C;
T-STEADY_STATE(T) = -gamma_d_T*eTaux*(by(-1)-byss)*ydss;
by = b/y;

Gc = Gcy*ydss+ydss*epsi_gc;
Igi = Igiy*ydss+ydss*epsi_igi;
Ige = Igey*ydss+ydss*epsi_ige;
Grd = Grdy*ydss+ydss*epsi_grd;
tauc = taucss+epsi_tauc;
tauw = tauwss+epsi_tauw;
@#else
// Canonical fiscal block: wasteful G is financed contemporaneously by an
// implicit lump-sum tax. Debt and distortionary taxes are absent.
b = 0;
T = 0;
by = 0;
Gc = Gcy*ydss+ydss*epsi_gc;
Igi = 0;
Ige = 0;
Grd = 0;
tauc = 0;
tauw = 0;
@#endif

@#if (SIMPLIFY_LEVEL < 2) && (NO_HUMAN_CAPITAL == 0)
Kge*g = (1-delta)*Kge(-1)+(1-eGE)*Ige;
@#else
Kge = STEADY_STATE(Kge);
@#endif

//********************************************************
// MARKET CLEARING
//********************************************************
@#if SIMPLIFY_LEVEL < 7
yd = C+Ip+Gc+Igi+Ige+Grd+(Z(-1)/A(-1)-1)*S;
@#else
yd = C+Gc;
@#endif

y = vp*yd;
vp = thetap*(PI(-1)^chi/PI)^(-epsilon)*vp(-1)+(1-thetap)*PIstar^(-epsilon);

eGE = eGE_ss-epsi_effge;
eGI = eGI_ss-epsi_effgi;
eGRD = eGRD_ss-epsi_effgrd;

//********************************************************
// REPORTING
//********************************************************
@#if SIMPLIFY_LEVEL < 7
G = Gc+Igi+Ige+Grd;
pdef_yss = (Gc+Igi+Ige+Grd+T-tauw*w*N-tauc*C)/ydss;
T_yss = T/ydss;
by_yss = b/(4*ydss); // government debt relative to annual steady-state GDP
@#else
G = Gc;
pdef_yss = 0;
T_yss = 0;
by_yss = 0;
@#endif
rreal = R/PI;

//********************************************************
// STEADY-STATE VALUES USED AS CONSTANTS
//********************************************************
omega = STEADY_STATE(omega);
Rss = STEADY_STATE(R);
ydss = STEADY_STATE(yd);
chiH = STEADY_STATE(chiH);
kappaprob = STEADY_STATE(kappaprob);
